# Local development only. Replace the placeholder before starting Compose.
POSTGRES_USER=indusai
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_DB=indusai

# Backend configuration. No provider credentials are required by the scaffold.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://indusai:replace-with-a-local-only-password@localhost:5432/indusai
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=regulatory_documents
LLM_PROVIDER=disabled
LLM_API_KEY=
DIGILOCKER_MODE=simulated
GOV_PORTAL_MODE=handoff_only
